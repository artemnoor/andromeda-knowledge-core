APP_ENV=development
APP_NAME=Andromeda Knowledge Core
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://andromeda:andromeda@localhost:5432/andromeda
ENGINE_VERSION=engine-0.1.0
AUTO_SEED=false
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
POSTGRES_PASSWORD=andromeda_local_only
MAX_REQUEST_BODY_BYTES=1048576
MAX_DSL_DEPTH=30
MAX_TRACE_NODES=5000
CONFIDENCE_REVIEW_THRESHOLD=0.8
ENABLE_SECURITY_HEADERS=true
